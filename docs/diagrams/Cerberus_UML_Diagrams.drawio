        </mxCell>

        <mxCell id="se-m1" value="read top sources / totals (1s tick)" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="115" y="110" as="sourcePoint" /><mxPoint x="355" y="110" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="se-note" value="[soft &lt;= count &lt; threshold]  -  source is ambiguous" style="text;html=1;align=left;fontStyle=2;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="115" y="150" width="320" height="20" as="geometry" />
        </mxCell>
        <mxCell id="se-m2" value="classify_flow(count, threshold)" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="115" y="200" as="sourcePoint" /><mxPoint x="600" y="200" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="se-m3" value="return (label, score)" style="html=1;endArrow=block;endFill=1;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="260" as="sourcePoint" /><mxPoint x="115" y="260" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="se-m4" value="insert_event('ml', label, score)" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="115" y="320" as="sourcePoint" /><mxPoint x="830" y="320" as="targetPoint" /></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="seq-adapt-page" name="Sequence - Adaptation">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="sa-title" value="Adaptation sequence (threshold updates - manual or automatic, both reload-free)" style="text;html=1;align=left;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="600" height="20" as="geometry" />
        </mxCell>

        <mxCell id="sa-p1" value="Operator" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sa-p2" value="API (FastAPI)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sa-p3" value="BPF Maps (config)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sa-p4" value="ControlLoop" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="710" y="40" width="150" height="30" as="geometry" />
        </mxCell>

        <mxCell id="sa-l1" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="110" y="70" as="sourcePoint" /><mxPoint x="110" y="440" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="sa-l2" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="330" y="70" as="sourcePoint" /><mxPoint x="330" y="440" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="sa-l3" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="555" y="70" as="sourcePoint" /><mxPoint x="555" y="440" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="sa-l4" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="785" y="70" as="sourcePoint" /><mxPoint x="785" y="440" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="sa-m1" value="POST /api/threshold {value}" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="110" y="110" as="sourcePoint" /><mxPoint x="330" y="110" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="sa-m2" value="set_threshold(value)" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="330" y="170" as="sourcePoint" /><mxPoint x="555" y="170" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="sa-div" value="OR - automatic path, no operator involved" style="text;html=1;align=center;fontStyle=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="220" width="675" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sa-divline" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="80" y="245" as="sourcePoint" /><mxPoint x="880" y="245" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="sa-m3" value="read totals (2s tick)" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="785" y="280" as="sourcePoint" /><mxPoint x="555" y="280" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="sa-note" value="[compute EWMA-smoothed rate; derive candidate threshold]" style="text;html=1;align=right;fontStyle=2;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="560" y="320" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sa-m4" value="write new threshold into config[0]" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="785" y="370" as="sourcePoint" /><mxPoint x="555" y="370" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="sa-note2" value="Next packet at the XDP hook reads this new value immediately - no reload." style="text;html=1;align=left;fontStyle=2;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="110" y="410" width="500" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
