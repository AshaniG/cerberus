  <diagram id="activity-page" name="Activity Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== LEFT FLOW: Tier-1 kernel packet path ===== -->
        <mxCell id="a-title1" value="Tier-1: Kernel Packet Path (runs once per packet)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="340" height="20" as="geometry" />
        </mxCell>

        <mxCell id="a-start1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="148" y="40" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a-1" value="Packet arrives at XDP hook" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-d1" value="Ethernet + IPv4 headers valid and packet is IPv4?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a-2" value="Increment ip_count[src]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-3" value="Read threshold from config map" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-d2" value="count &gt;= threshold?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- No branch of headers-valid: early exit -->
        <mxCell id="a-exit" value="Return XDP_PASS (early exit)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="195" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-end-exit" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="445" y="270" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Yes branch of threshold: dropped -->
        <mxCell id="a-4" value="Increment dropped tally" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="440" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-5" value="Return XDP_DROP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="510" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-end-drop" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="445" y="580" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- No branch of threshold: passed -->
        <mxCell id="a-6" value="Increment passed tally" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-7" value="Return XDP_PASS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="630" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-end-pass" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="145" y="700" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Left flow edges -->
        <mxCell id="ae1" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a-start1" target="a-1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae2" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a-1" target="a-d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae3" value="yes" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="a-d1" target="a-2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae4" value="no" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="a-d1" target="a-exit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae5" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a-exit" target="a-end-exit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae6" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a-2" target="a-3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae7" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a-3" target="a-d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae8" value="yes" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="a-d2" target="a-4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae9" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a-4" target="a-5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae10" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a-5" target="a-end-drop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae11" value="no" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="a-d2" target="a-6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae12" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a-6" target="a-7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae13" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a-7" target="a-end-pass"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== RIGHT FLOW: Userspace escalation tick ===== -->
        <mxCell id="a-title2" value="Userspace: Escalation Tick (runs independently, once per second)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="10" width="360" height="20" as="geometry" />
        </mxCell>

        <mxCell id="b-start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="808" y="40" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="b-1" value="Read BPF maps (totals + top sources)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="710" y="90" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-d1" value="source count in the ambiguous band?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="160" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b-end-no" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="960" y="180" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b-2" value="Escalate: call classify_flow(source)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="710" y="270" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-3" value="Record ml event (label, score)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="710" y="340" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-end-yes" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="805" y="410" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="be1" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b-start" target="b-1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be2" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b-1" target="b-d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be3" value="no" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="b-d1" target="b-end-no"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be4" value="yes" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="b-d1" target="b-2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be5" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b-2" target="b-3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be6" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b-3" target="b-end-yes"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="a-note" value="The two flows run independently: the left flow executes inside the kernel for every packet; the right flow runs in userspace on its own one-second timer and never blocks packet forwarding." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="740" width="900" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="seq-filter-page" name="Sequence - Filtering">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="sf-title" value="Filtering sequence (Tier 1, entirely inside the kernel)" style="text;html=1;align=left;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="500" height="20" as="geometry" />
        </mxCell>

        <mxCell id="sf-p1" value="Attacker / Legitimate Traffic" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
