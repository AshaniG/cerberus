        </mxCell>
        <mxCell id="sf-m3" value="read config[0] (threshold)" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="410" y="250" as="sourcePoint" /><mxPoint x="690" y="250" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="sf-m4" value="verdict: XDP_DROP or XDP_PASS" style="html=1;endArrow=block;endFill=1;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="410" y="330" as="sourcePoint" /><mxPoint x="120" y="330" as="targetPoint" /></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="seq-escalate-page" name="Sequence - Escalation">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="se-title" value="Escalation sequence (Tier 2, userspace, ambiguous sources only)" style="text;html=1;align=left;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="550" height="20" as="geometry" />
        </mxCell>

        <mxCell id="se-p1" value="Collector" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="150" height="30" as="geometry" />
