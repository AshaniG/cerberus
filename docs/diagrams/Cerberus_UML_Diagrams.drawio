          <mxGeometry x="520" y="40" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="se-p4" value="Database" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="40" width="120" height="30" as="geometry" />
        </mxCell>

        <mxCell id="se-l1" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="115" y="70" as="sourcePoint" /><mxPoint x="115" y="370" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="se-l2" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="70" as="sourcePoint" /><mxPoint x="355" y="370" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="se-l3" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1">
